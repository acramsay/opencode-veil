{
  "name": "@acramsay/opencode-veil",
  "version": "1.1.0",
  "description": "opencode plugin that redacts secrets from prompts and tool outputs before they reach the LLM, via fully local gitleaks scanning",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acramsay/opencode-veil.git"
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./server": "./src/plugin.ts"
  },
  "files": [
    "src/audit.ts",
    "src/gitleaks.ts",
    "src/plugin.ts",
    "src/scan.ts",
    "src/targets-v1.ts",
    "src/targets-v2.ts",
    "src/v1.ts",
    "src/v2.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test src/",
    "test:integration": "bun test test/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode-ai/sdk": "^1.18.29",
    "@opencode/ai": "^2.0.18",
    "@opencode/plugin": "^2.0.18",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.4.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogTitle": "# Changelog"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
