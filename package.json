{
  "name": "@acramsay/opencode-veil",
  "version": "1.1.0",
  "description": "opencode plugin that redacts secrets from prompts and tool outputs before they reach the LLM, via fully local gitleaks scanning",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acramsay/opencode-veil.git"
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.entry.mjs"
  },
  "files": [
    "src/gitleaks.ts",
    "src/plugin.ts",
    "src/rpc.ts",
    "src/scan.ts",
    "src/store.ts",
    "src/targets.ts",
    "src/tui.compiled.tsx",
    "src/tui.entry.mjs",
    "src/tui.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test src/",
    "test:integration": "bun test test/",
    "build:tui": "bun scripts/build-tui.ts",
    "prepublishOnly": "bun run build:tui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opencode/ai": "^2.2.5",
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.4.4",
    "semantic-release": "^25.0.9",
    "solid-js": "^1.9.18",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogTitle": "# Changelog"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
